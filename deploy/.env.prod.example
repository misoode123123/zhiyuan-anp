# 智源 ANP 生产环境变量（复制为 .env.prod 并填值）
ENV=prod
LOG_LEVEL=info

# 日志输出（M2）：prod 建议 json + file 落盘滚动
# 容器挂 ../data:/data，故 /data/logs/* 落到宿主 ../data/logs/
LOG_FORMAT=json
LOG_OUTPUT=file
LOG_FILE=/data/logs/app.log
LOG_ERROR_FILE=/data/logs/error.log
LOG_MAX_SIZE_MB=100
LOG_MAX_BACKUPS=7
LOG_MAX_AGE_DAYS=30

# 数据库密码（postgres 服务用）
DB_PASSWORD=anp

# 智谱 GLM（必填）
ZHIPUAI_API_KEY=填你的智谱key
DEFAULT_MODEL=zhipu/glm-4-flash

# opencode 编码默认模型（研发工作台）
DEFAULT_CODE_MODEL=zai-coding/glm-5.1

# opencode 所需（容器内）
OPENCODE_GIT_BASH_PATH=/bin/bash
