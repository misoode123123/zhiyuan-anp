# 智源 ANP 后端 + opencode 编码引擎
FROM golang:1.25-alpine AS build
ENV GOPROXY=https://goproxy.cn,direct
ENV GOTOOLCHAIN=local
WORKDIR /src
COPY platform/backend/go.mod platform/backend/go.sum ./
RUN go mod download
COPY platform/backend/ ./
RUN CGO_ENABLED=0 go build -o /server ./cmd/server

FROM alpine:3.19
# 国内 alpine 镜像源，加速 apk（.28 等国内服务器到 dl-cdn 很慢）
RUN sed -i 's#https://dl-cdn.alpinelinux.org#https://mirrors.aliyun.com#g; s#http://dl-cdn.alpinelinux.org#https://mirrors.aliyun.com#g' /etc/apk/repositories
RUN apk add --no-cache ca-certificates git bash curl libc6-compat nodejs npm docker-cli ttyd
RUN npm config set registry https://registry.npmmirror.com && npm i -g opencode-ai @anthropic-ai/claude-code
WORKDIR /app
COPY --from=build /server /app/server
# 非 web 形态脚手架种子（建 desktop/mobile/cli 应用时克隆到 RepoDir）。
# 必须显式 COPY：构建上下文在仓库根，但 COPY 仅落 platform/backend 时不带 deploy/scaffolds，
# 生产容器内 scaffoldBase=deploy/scaffolds（相对 /app）会找不到 → cloneScaffold 静默跳过。
COPY deploy/scaffolds /app/deploy/scaffolds
EXPOSE 8080
CMD ["/app/server"]
